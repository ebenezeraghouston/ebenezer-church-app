rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.uid == 'xc2p3vvI9taVr4uPj1cW8n413oz1'; }
    function approved() {
      return admin() || (signedIn() &&
        exists(/databases/$(database)/documents/approvedMembers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/approvedMembers/$(request.auth.uid)).data.approved == true);
    }
    match /accessRequests/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['email','name','requestedAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.name is string && request.resource.data.name.size() <= 120 &&
        request.resource.data.requestedAt == request.time;
      allow update, delete: if admin();
    }
    match /approvedMembers/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin();
      allow create, update: if admin() &&
        request.resource.data.keys().hasOnly(['approved','email','name','approvedAt']) &&
        request.resource.data.approved is bool &&
        request.resource.data.email is string &&
        request.resource.data.name is string;
      allow delete: if admin();
    }
    match /directory/{entryId} {
      allow read: if approved();
      allow create, update: if admin() &&
        request.resource.data.keys().hasOnly(['name','phone','email','address','family','notes']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 60 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 150 &&
        request.resource.data.address is string && request.resource.data.address.size() <= 250 &&
        request.resource.data.family is string && request.resource.data.family.size() <= 200 &&
        request.resource.data.notes is string && request.resource.data.notes.size() <= 300;
      allow delete: if admin();
    }
    match /adminAnnouncements/{announcementId} {
      allow create: if admin() &&
        request.resource.data.keys().hasOnly(['title','message','status','createdAt']) &&
        request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 90 &&
        request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 500 &&
        request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow get, list: if admin();
      allow update, delete: if false;
    }
    match /prayerRequests/{requestId} {
      allow create: if
        request.resource.data.keys().hasOnly(['message','status','createdAt','expiresAt']) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 10 &&
        request.resource.data.message.size() <= 500 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt > request.time + duration.value(29, 'd') &&
        request.resource.data.expiresAt < request.time + duration.value(31, 'd');
      allow get, list: if admin() || resource.data.status == 'approved';
      allow update: if admin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','expiresAt']) &&
        request.resource.data.status in ['approved','rejected'] &&
        request.resource.data.reviewedAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt > request.time + duration.value(6, 'd') &&
        request.resource.data.expiresAt < request.time + duration.value(8, 'd');
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}